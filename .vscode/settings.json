{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"tailwindCSS.classAttributes": ["class", "className", "theme"],
	"tailwindCSS.experimental.classRegex": [
		[
			"twMerge\\(([^)]*)\\)",
			"[\"'`]([^\"'`]*).*?[\"'`]",
			"newReadonlyModel\\({([^)]*)}\\)",
			"[\"'`]([^\"'`]*).*?[\"'`]"
		],
		[
			"createTheme(?:<\\w+>)?\\s*\\(([^)]*)\\)",
			"{?\\s?[\\w].*:\\s*?[\"'`]([^\"'`]*).*?,?\\s?}?"
		]
	],
	"js/ts.experimental.useTsgo": false,
	"[tailwindcss]": {
		"tailwindCSS.lint.invalidTailwindDirective": "warning",
		"tailwindCSS.validate": true
	}
}
