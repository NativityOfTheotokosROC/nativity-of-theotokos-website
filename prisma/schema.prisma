// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quote {
  id          Int          @id @default(autoincrement())
  quote       Translation  @relation("QuoteTranslation", fields: [quoteTranslationId], references: [id])
  author      QuoteAuthor  @relation(fields: [authorId], references: [id])
  source      Translation? @relation("QuoteSourceTranslation", fields: [sourceTranslationId], references: [id])
  dailyQuotes DailyQuote[]

  quoteTranslationId  Int  @unique
  sourceTranslationId Int?
  authorId            Int
}

model QuoteAuthor {
  id                Int         @id @default(autoincrement())
  name              Translation @relation(fields: [nameTranslationId], references: [id])
  nameTranslationId Int         @unique
  quotes            Quote[]
}

model DailyQuote {
  date    DateTime @id @default(now()) @db.Date
  quote   Quote    @relation(fields: [quoteId], references: [id])
  quoteId Int
}

model InstantaneousScheduleItem {
  id                             Int                               @id @default(autoincrement())
  title                          Translation                       @relation("ScheduleItemTitleTranslation", fields: [titleTranslationId], references: [id])
  venue                          Translation                       @relation("ScheduleItemVenueTranslation", fields: [venueTranslationId], references: [id])
  date                           DateTime                          @db.Date
  removedScheduleItem            RemovedInstantaneousScheduleItem?
  instantaneousScheduleItemTimes InstantaneousScheduleItemTime[]
  titleTranslationId             Int
  venueTranslationId             Int

  @@unique([venueTranslationId, date])
}

model RecurringScheduleItem {
  id                            Int                            @id @default(autoincrement())
  title                         Translation                    @relation("ScheduleItemTitleTranslation", fields: [titleTranslationId], references: [id])
  venue                         Translation                    @relation("ScheduleItemVenueTranslation", fields: [venueTranslationId], references: [id])
  pattern                       String
  disabledRecurringScheduleItem DisabledRecurringScheduleItem?
  recurringScheduleItemTimes    RecurringScheduleItemTime[]
  titleTranslationId            Int
  venueTranslationId            Int

  @@unique([venueTranslationId, pattern])
}

model InstantaneousScheduleItemTime {
  id                          Int                       @id @default(autoincrement())
  time                        DateTime                  @db.Time
  designation                 Translation               @relation(fields: [designationTranslationId], references: [id])
  instantaneousScheduledItem  InstantaneousScheduleItem @relation(fields: [instantaneousScheduleItemId], references: [id], onDelete: Cascade)
  designationTranslationId    Int
  instantaneousScheduleItemId Int

  @@unique([designationTranslationId, time])
}

model RecurringScheduleItemTime {
  id                       Int                   @id @default(autoincrement())
  time                     DateTime              @db.Time
  designation              Translation           @relation(fields: [designationTranslationId], references: [id])
  recurringScheduledItem   RecurringScheduleItem @relation(fields: [recurringScheduleItemId], references: [id])
  designationTranslationId Int
  recurringScheduleItemId  Int

  @@unique([designationTranslationId, time])
}

model RemovedInstantaneousScheduleItem {
  scheduleItem                InstantaneousScheduleItem @relation(fields: [instantaneousScheduleItemId], references: [id], onDelete: Cascade)
  instantaneousScheduleItemId Int                       @id
}

model DisabledRecurringScheduleItem {
  scheduleItem            RecurringScheduleItem @relation(fields: [recurringScheduleItemId], references: [id], onDelete: Cascade)
  recurringScheduleItemId Int                   @id
}

model Article {
  id              Int              @id @default(autoincrement())
  link            String           @unique
  title           Translation      @relation("ArticleTitleTranslation", fields: [titleTranslationId], references: [id])
  body            Translation      @relation("ArticleBodyTranslation", fields: [bodyTranslationId], references: [id])
  snippet         Translation      @relation("ArticleSnippetTranslation", fields: [snippetTranslationId], references: [id])
  author          ArticleAuthor    @relation(fields: [authorId], references: [id])
  image           ArticleImage     @relation(fields: [imageId], references: [id])
  dateCreated     DateTime         @default(now())
  dateUpdated     DateTime?
  featuredArticle FeaturedArticle?

  titleTranslationId   Int
  bodyTranslationId    Int
  snippetTranslationId Int
  authorId             Int
  imageId              Int
  articleTickets       ArticleTicket[]
}

model ArticleAuthor {
  id                Int             @id @default(autoincrement())
  name              Translation     @relation(fields: [nameTranslationId], references: [id])
  email             String          @unique
  nameTranslationId Int             @unique
  articles          Article[]
  articleTickets    ArticleTicket[]
}

model ArticleImage {
  id                   Int               @id @default(autoincrement())
  link                 String            @unique
  caption              Translation       @relation(fields: [captionTranslationId], references: [id])
  placeholder          ImagePlaceholder? @relation(fields: [placeholderId], references: [id])
  captionTranslationId Int
  placeholderId        Int?
  articles             Article[]
}

model FeaturedArticle {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int     @id
}

model ArticleTicket {
  id            String        @id @default(uuid())
  assignee      ArticleAuthor @relation(fields: [assigneeEmail], references: [email])
  assigneeEmail String
  assignerEmail String?
  articleDraft  ArticleDraft?
  article       Article?      @relation(fields: [articleId], references: [link])
  articleId     String?       @unique
}

model ArticleDraft {
  id                       Int                       @id @default(autoincrement())
  title                    String
  body                     String
  lastSaved                DateTime                  @default(now())
  articleTicket            ArticleTicket             @relation(fields: [articleTicketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleTicketId          String                    @unique
  pendingArticleSubmission PendingArticleSubmission?
}

model PendingArticleSubmission {
  articleDraft   ArticleDraft @relation(fields: [articleDraftId], references: [id], onDelete: Cascade)
  articleDraftId Int          @id
  assignedEditor Editor?      @relation(fields: [editorEmail], references: [email])
  editorEmail    String?
}

model DailyGalleryImage {
  id            Int               @id @default(autoincrement())
  date          DateTime          @db.Date
  link          String
  placeholder   ImagePlaceholder? @relation(fields: [placeholderId], references: [id])
  placeholderId Int?

  @@unique([date, link])
}

model Admin {
  id    Int    @id @default(autoincrement())
  email String
  role  String

  @@unique([email, role])
}

model Editor {
  id                        Int                        @id @default(autoincrement())
  email                     String                     @unique
  pendingArticleSubmissions PendingArticleSubmission[]
}

model ImagePlaceholder {
  id                 Int                 @id @default(autoincrement())
  imageLink          String              @unique
  placeholder        String
  articleImages      ArticleImage[]
  dailyGalleryImages DailyGalleryImage[]
}

model Translation {
  id          Int     @id @default(autoincrement())
  english     String
  russian     String?
  englishHash String  @unique

  articleImageCaptions             ArticleImage[]
  articleAuthors                   ArticleAuthor[]
  quoteAuthors                     QuoteAuthor[]
  quoteTranslations                Quote[]                         @relation("QuoteTranslation")
  quoteSourceTranslations          Quote[]                         @relation("QuoteSourceTranslation")
  articleTitleTranslations         Article[]                       @relation("ArticleTitleTranslation")
  articleBodyTranslations          Article[]                       @relation("ArticleBodyTranslation")
  articleSnippetTranslations       Article[]                       @relation("ArticleSnippetTranslation")
  instantaneousScheduleItemTimes   InstantaneousScheduleItemTime[]
  recurringScheduleItemTimes       RecurringScheduleItemTime[]
  instantaneousScheduleItemTitles  InstantaneousScheduleItem[]     @relation("ScheduleItemTitleTranslation")
  instantaneousScheduleItemsVenues InstantaneousScheduleItem[]     @relation("ScheduleItemVenueTranslation")
  recurringScheduleItemTitles      RecurringScheduleItem[]         @relation("ScheduleItemTitleTranslation")
  recurringScheduleItemVenues      RecurringScheduleItem[]         @relation("ScheduleItemVenueTranslation")
}

model Commemoration {
  id String @id
}

// BetterAuth  ----------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
